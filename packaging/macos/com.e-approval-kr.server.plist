<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- e-approval-kr LaunchDaemon. Runs as the hidden system user _eapprovalkr (created by postinstall).
     `serve` without host/port options uses server.json in the data directory (setup wizard);
     default 127.0.0.1:8130 (this Mac only). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.e-approval-kr.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/lib/e-approval-kr/e-approval-kr</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>GYEOLJAE_DATA</key>
        <string>/Library/Application Support/e-approval-kr</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
    <key>UserName</key>
    <string>_eapprovalkr</string>
    <key>GroupName</key>
    <string>_eapprovalkr</string>
    <key>WorkingDirectory</key>
    <string>/Library/Application Support/e-approval-kr</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Library/Logs/e-approval-kr/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/e-approval-kr/server.log</string>
</dict>
</plist>
